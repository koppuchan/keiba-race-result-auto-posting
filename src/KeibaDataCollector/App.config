<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!--
      機密情報（利用キー、パスワード、ソフトウェアID等）はここに直接書かず、
      同名の環境変数で上書きしてください（AppConfig.cs が環境変数を優先して読みます）。
      ここに書いてよいのは非機密の既定値・雛形のみです。
    -->
    <add key="JvLinkProgId" value="JVDTLab.JVLink" />
    <!-- 実機のレジストリ(HKLM\SOFTWARE\Classes)で確認済み: NVDTLabLib.NVLink -->
    <add key="UmaConnProgId" value="NVDTLabLib.NVLink" />

    <add key="JvLinkSoftwareId" value="" />

    <add key="WordPressBaseUrl" value="https://keiba-tips.top" />
    <add key="WordPressUser" value="" />
    <add key="WordPressAppPassword" value="" />

    <add key="RealtimePollIntervalSeconds" value="20" />

    <!--
      予想印の付け方（odds / shadow / score）。詳しくは AppConfig.PredictionMethod。
      score: 下の PreSaleGroups の区分は発売前スコアの印を公開する。それ以外はオッズの人気順（比較のログを出す）。
      2026-11-26 お客様の了承を得て、地方競馬から score に切り替えた
      （並行稼働の 11/25 の比較で、印が最終5番人気以内: 発売前スコア 83% / 発売直後のオッズ 54%）。
    -->
    <add key="PredictionMethod" value="score" />
    <!--
      score のとき発売前スコアの印を公開する区分（jra=中央 / nar=地方 / banei=ばんえい、カンマ区切り）。
      含めない区分はオッズの人気順のまま（比較のログは出る）。中央・ばんえいは、実際の開催日で比較してから加える。
    -->
    <add key="PreSaleGroups" value="nar" />
    <!-- 発売前スコアで読む過去データ（keiba-ai-data-system のDB。読み取り専用で開く） -->
    <add key="KeibaAiHistoryDbPath" value="C:\keiba-ai-data-system\src\KeibaDataCollector\bin\Debug\net48\data\historical.sqlite3" />
  </appSettings>
</configuration>
